{
  "rewrites": [
    {
      "source": "/san-pham/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(zalo|facebookexternalhit|facebot|telegrambot|twitterbot|slackbot|whatsapp|discordbot).*"
        }
      ],
      "destination": "/api/product-preview.js?slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|decor-clean/|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/decor-clean/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
