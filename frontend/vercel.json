{
  "rewrites": [
    {
      "source": "/san-pham/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(zalo|facebookexternalhit|facebot|telegrambot|twitterbot|slackbot|whatsapp|discordbot).*"
        }
      ],
      "destination": "/api/product-preview.js?slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|decor-clean/|favicon.ico|robots.txt|og-banner.jpg|og-banner.png|logo_new.png|.*\\.(?:ico|png|jpg|jpeg|webp|svg|css|js|json|txt|xml|wasm)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|webp|svg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/decor-clean/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
