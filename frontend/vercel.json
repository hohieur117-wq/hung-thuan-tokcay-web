{
  "rewrites": [
    { "source": "/((?!assets/|decor-clean/|favicon.ico|robots.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/decor-clean/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
